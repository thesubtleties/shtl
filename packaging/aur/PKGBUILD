# Maintainer: sbtl.dev
pkgname=shtl
pkgver=0.2.0
pkgrel=1
pkgdesc="Keyboard-first window placement for Hyprland: blueprints, slots, constellations and a two-hand panel"
arch=('any')
url="https://github.com/thesubtleties/shtl"
license=('GPL-3.0-or-later')
depends=('hyprland>=0.56' 'quickshell' 'ttf-fira-sans')
optdepends=('keyd: hold Space to open the panel'
            'ttf-jetbrains-mono-nerd: keycap legends')
install=shtl.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f41e3d2f3fe254c8cf0942848886b227ff361338f0481c7a02da5a45681b9491')

package() {
    cd "$pkgname-$pkgver"
    install -d "$pkgdir/usr/share/shtl"
    cp -r hypr panel bin extras "$pkgdir/usr/share/shtl/"
    chmod 755 "$pkgdir/usr/share/shtl/bin/shtl-listen" "$pkgdir/usr/share/shtl/bin/shtl"
    install -d "$pkgdir/usr/bin"
    ln -s /usr/share/shtl/bin/shtl "$pkgdir/usr/bin/shtl"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
