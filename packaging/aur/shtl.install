post_install() {
    echo "==> To turn shtl on, run:  shtl setup"
    echo "    It shows the one line it adds to your Hyprland config and asks before changing anything."
    echo "==> Then Super+Space opens the panel; with it open, Super+, for settings."
}

post_upgrade() {
    echo "==> shtl updated: reload Hyprland (hyprctl reload) to load the new version."
}

pre_remove() {
    echo "==> Run 'shtl setup --undo' first if you added shtl to your Hyprland config."
}
